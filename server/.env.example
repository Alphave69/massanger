# Скопируй этот файл в server/.env и впиши свои данные.
# server/.env в git НЕ попадает — пароль остаётся только у тебя.

# Почта для писем с кодами (Яндекс)
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=Nuntiuspilulae@yandex.com
SMTP_PASS=сюда_пароль_приложения_из_16_букв
SMTP_FROM="Nuntius <Nuntiuspilulae@yandex.com>"

# Ключ для токенов входа — случайная строка не короче 32 символов. Без него на сервере (NODE_ENV=production)
# Nuntius не запустится; у себя на компьютере можно не трогать — при первом запуске он создастся сам.
# Создать: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
