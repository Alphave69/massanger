# Скопируй этот файл в server/.env и впиши свои данные.
# server/.env в git НЕ попадает — пароль остаётся только у тебя.

# Почта для писем с кодами (Яндекс)
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=Nuntiuspilulae@yandex.com
